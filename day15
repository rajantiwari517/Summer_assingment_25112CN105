//write a programm to reverse an array.
package javaprogramming;

import java.util.Scanner;

public class basics {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       
       System.out.println("write the length of the array");
       int n=sc.nextInt();
       int[] arr=new int[n];
       for(int i=0;i<n;i++){
        arr[i]=sc.nextInt();
       }
       int i=0;
       int j=n-1;
      while(j>i){
        int temp=arr[i];
        arr[i]=arr[j];
        arr[j]=temp;
        i++;
        j--;

      }
      for(int x=0;x<n;x++){
        System.out.print(arr[x]);
      }

    }
}
