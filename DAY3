//programm to find gcd of two no.
import java.util.Scanner;
public class practice2 {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int x=sc.nextInt();
        int y=sc.nextInt();
        int less=Math.min(x,y);
        for(int i=less;i>0;i--){
            if(x%i==0&& y%i==0){
                System.out.print(i+" ");
             break;}
           
        }
    }
}




