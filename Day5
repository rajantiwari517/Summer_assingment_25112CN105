import java.util.Scanner;

public class practice {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int x = sc.nextInt();
        int primefactor = 0;

        for (int i = 2; i <= x; i++) {
            if (x % i == 0) {

                boolean prime = true;

                for (int a = 2; a < i; a++) {
                    if (i % a == 0) {
                        prime = false;
                        break;
                    }
                }

                if (prime) {
                    primefactor = i;
                }
            }
        }

        System.out.println(primefactor);
    }
}
