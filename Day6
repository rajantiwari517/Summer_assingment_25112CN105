//program to convert decimal to binary;
import java.util.Scanner;

public class practice {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int x = sc.nextInt();
        int ans=0;

      while(x!=0){
        int r=0;
        r=x%2;
        x=x/2;
        ans=(10*ans)+r;

        
      }
      int ans2=0;
      while(ans!=0){
        int r=0;
        r=ans%10;
        ans=ans/10;
        ans2=(10*ans2)+r;

      }
      System.out.println(ans2);
    }
}




