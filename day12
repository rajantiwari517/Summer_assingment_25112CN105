//write a program to write function for armstrong no..
import java.util.Scanner;
public class practice {
    public static int armstrongno(int a){
        int count=0;
        int ans=0;
        int c=a;
        while(c!=0){
            c=c/10;
            count++;
        }
        while(a!=0){
            int r=0;
            r=a%10;
            ans=ans+(int)Math.pow(r, count);
         
            a=a/10;

        }
        return ans;
    }
 public static void main(String[] args) {
     Scanner sc=new Scanner(System.in);
     int a=sc.nextInt();
 
       int b=armstrongno(a);
       if(a==b)System.out.println("yes it is a armstrong no");
       else{
        System.out.println("no it is not a armstorng no");
       }
     }
    }





