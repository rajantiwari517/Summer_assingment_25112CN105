//write a program to write function for perfect no..
import java.util.Scanner;
public class practice {
    public static void perfectno(int a){
        int ans=0;
        for(int i=1;i<a;i++){
            if(a%i==0)ans=ans+i;
        }
        if(ans==a)System.out.println("it is a perfect no");
        else{System.out.println("no is is not a perfect no");}
    
       
    }
 public static void main(String[] args) {
     Scanner sc=new Scanner(System.in);
     int a=sc.nextInt();
    perfectno(a);
  
       
     }
    }
