   public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int arm=0;
    int r;
    int fn=n;
    while(fn!=0){
        r=fn%10;
        arm=arm+(r*r*r);
        fn=fn/10;


    }
    if(arm==n)System.out.println("yes it is a armstirong no");
    else {
        System.out.println("no it is not a armstrong no");
    }
       
        }
    
  }






